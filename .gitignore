# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.playwright-mcp

# Environment variables
.env
.env.*
!.env.example

# Vercel
.vercel

# TypeScript build info cache
*.tsbuildinfo

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Reference PDFs and copyrighted/sensitive material
references/originals/*
!references/originals/.gitkeep
references/working/*
!references/working/.gitkeep

# Data artifacts
data/extracted/*
!data/extracted/.gitkeep
data/validated/*
!data/validated/.gitkeep
data/research/*
!data/research/.gitkeep
data/input/*
!data/input/.gitkeep
data/output/*
